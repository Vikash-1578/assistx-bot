# ============================================================
# TELEGRAM
# ============================================================
BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# ============================================================
# AI ENGINE — GLOBAL
# ============================================================
AI_REQUEST_TIMEOUT=45
AI_MAX_RETRIES=2
AI_MAX_OUTPUT_TOKENS=4096
AI_TEMPERATURE=0.7
AI_COOLDOWN_SECONDS=60
AI_FAILURE_THRESHOLD=3
GLOBAL_AI_CONCURRENCY=5
USER_AI_CONCURRENCY=1
AI_QUOTA_DB=data/ai_usage.db

# ============================================================
# GROQ
# ============================================================
GROQ_ENABLED=true
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_DAILY_QUOTA=1000
GROQ_PRIORITY=10
GROQ_MODEL_CHAT=llama-3.3-70b-versatile
GROQ_MODEL_CODE=llama-3.3-70b-versatile
GROQ_MODEL_CONTENT=llama-3.3-70b-versatile
GROQ_MODEL_FREELANCE=llama-3.3-70b-versatile
GROQ_MODEL_REASONING=llama-3.3-70b-versatile
GROQ_MODEL_SUMMARY=llama-3.1-8b-instant

# ============================================================
# GOOGLE GEMINI (OpenAI-compatible endpoint)
# ============================================================
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GEMINI_DAILY_QUOTA=1000
GEMINI_PRIORITY=20
GEMINI_MODEL_CHAT=gemini-2.0-flash
GEMINI_MODEL_CODE=gemini-2.0-flash
GEMINI_MODEL_CONTENT=gemini-2.0-flash
GEMINI_MODEL_FREELANCE=gemini-2.0-flash
GEMINI_MODEL_REASONING=gemini-2.0-flash
GEMINI_MODEL_SUMMARY=gemini-2.0-flash-lite

# ============================================================
# OPENROUTER
# ============================================================
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DAILY_QUOTA=50
OPENROUTER_PRIORITY=30
OPENROUTER_MODEL_CHAT=meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL_CODE=meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL_CONTENT=meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL_FREELANCE=meta-llama/llama-3.3-70b-instruct
OPENROUTER_MODEL_REASONING=deepseek/deepseek-r1
OPENROUTER_MODEL_SUMMARY=meta-llama/llama-3.1-8b-instruct

# ============================================================
# CEREBRAS
# ============================================================
CEREBRAS_ENABLED=false
CEREBRAS_API_KEY=
CEREBRAS_BASE_URL=https://api.cerebras.ai/v1
CEREBRAS_DAILY_QUOTA=1000
CEREBRAS_PRIORITY=40
CEREBRAS_MODEL_CHAT=llama-3.3-70b
CEREBRAS_MODEL_CODE=llama-3.3-70b
CEREBRAS_MODEL_CONTENT=llama-3.3-70b
CEREBRAS_MODEL_FREELANCE=llama-3.3-70b
CEREBRAS_MODEL_REASONING=llama-3.3-70b
CEREBRAS_MODEL_SUMMARY=llama3.1-8b

# ============================================================
# SAMBANOVA
# ============================================================
SAMBANOVA_ENABLED=false
SAMBANOVA_API_KEY=
SAMBANOVA_BASE_URL=https://api.sambanova.ai/v1
SAMBANOVA_DAILY_QUOTA=1000
SAMBANOVA_PRIORITY=50
SAMBANOVA_MODEL_CHAT=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_MODEL_CODE=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_MODEL_CONTENT=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_MODEL_FREELANCE=Meta-Llama-3.3-70B-Instruct
SAMBANOVA_MODEL_REASONING=DeepSeek-R1
SAMBANOVA_MODEL_SUMMARY=Meta-Llama-3.1-8B-Instruct

# ============================================================
# HUGGING FACE
# ============================================================
HF_ENABLED=false
HF_API_KEY=
HF_BASE_URL=https://router.huggingface.co/v1
HF_DAILY_QUOTA=100
HF_PRIORITY=60
HF_MODEL_CHAT=meta-llama/Llama-3.3-70B-Instruct
HF_MODEL_CODE=Qwen/Qwen2.5-Coder-32B-Instruct
HF_MODEL_CONTENT=meta-llama/Llama-3.3-70B-Instruct
HF_MODEL_FREELANCE=meta-llama/Llama-3.3-70B-Instruct
HF_MODEL_REASONING=deepseek-ai/DeepSeek-R1
HF_MODEL_SUMMARY=meta-llama/Llama-3.1-8B-Instruct

# ============================================================
# VECTOR STORE
# ============================================================
VECTOR_BACKEND=memory
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=telegram_ai_agent
VECTOR_TOP_K=5
VECTOR_SCORE_THRESHOLD=0.35

PINECONE_API_KEY=
PINECONE_INDEX_NAME=
PINECONE_NAMESPACE=default

# ============================================================
# TELEGRAM PRIVATE CHANNEL STORAGE
# ============================================================
STORAGE_CHANNEL_ID=

# ============================================================
# HEALTH SERVER
# ============================================================
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5

# -------- NVIDIA --------
NVIDIA_ENABLED=false
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_DAILY_QUOTA=1000
NVIDIA_PRIORITY=60
NVIDIA_MODEL_CHAT=meta/llama-3.3-70b-instruct

# -------- VISION MODELS --------
GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_MODEL_VISION=gemini-2.0-flash
OPENROUTER_MODEL_VISION=meta-llama/llama-3.2-11b-vision-instruct
CEREBRAS_MODEL_VISION=qwen-3.8-27b
SAMBANOVA_MODEL_VISION=Llama-3.2-11B-Vision-Instruct
NVIDIA_MODEL_VISION=meta/llama-3.2-11b-vision-instruct
HF_MODEL_VISION=

# -------- VISION MODELS --------
GROQ_MODEL_VISION=meta-llama/llama-4-scout-17b-16e-instruct
GEMINI_MODEL_VISION=gemini-2.0-flash
OPENROUTER_MODEL_VISION=meta-llama/llama-3.2-11b-vision-instruct
CEREBRAS_MODEL_VISION=qwen-3.8-27b
SAMBANOVA_MODEL_VISION=Llama-3.2-11B-Vision-Instruct
NVIDIA_MODEL_VISION=meta/llama-3.2-11b-vision-instruct
HF_MODEL_VISION=

# -------- FREELLMAPI (local gateway) --------
FREELLMAPI_ENABLED=false
FREELLMAPI_API_KEY=
FREELLMAPI_BASE_URL=http://127.0.0.1:3001/v1
FREELLMAPI_DAILY_QUOTA=999999
FREELLMAPI_PRIORITY=1
FREELLMAPI_MODEL_CHAT=auto
FREELLMAPI_MODEL_CODE=auto
FREELLMAPI_MODEL_CONTENT=auto
FREELLMAPI_MODEL_FREELANCE=auto
FREELLMAPI_MODEL_REASONING=auto
FREELLMAPI_MODEL_SUMMARY=auto
FREELLMAPI_MODEL_VISION=
